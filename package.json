{
  "name": "fhfs",
  "version": "0.1.0",
  "private": true,
  "description": "fhf's — a personal magazine and private gallery: writing, software, motion studies, and a few rooms with their own records.",
  "homepage": "https://fhfs.fhfs.workers.dev",
  "repository": "github:fanhefeng/fhfs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "pnpm assets && vp dev --host 127.0.0.1",
    "build": "pnpm assets && vp build",
    "preview": "pnpm check:runtime && vp preview --host 127.0.0.1",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:worker-runtime": "pnpm check:runtime && node scripts/check-worker-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "import:notebook": "node --import tsx scripts/import-notebook.ts",
    "icons:export": "node scripts/export-icons.mjs",
    "check": "pnpm check:worker-runtime && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "deploy": "pnpm assets && void deploy --platform cloudflare",
    "deploy:cloudflare": "pnpm assets && void deploy --platform cloudflare",
    "assets": "pnpm check:worker-runtime && node scripts/export-icons.mjs && node scripts/prepare-assets.mjs && tsx scripts/prepare-share-images.ts",
    "prepare": "pnpm check:runtime && node scripts/patch-bundled-undici.mjs && void prepare",
    "smoke": "pnpm check:runtime && node scripts/smoke.mjs",
    "uptime": "pnpm check:runtime && tsx scripts/uptime.mts",
    "deploy:monitor": "pnpm check:worker-runtime && wrangler deploy --config ops/uptime/wrangler.jsonc",
    "e2e": "pnpm check:runtime && tsx scripts/e2e.mts"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@gsap/react": "^2.1.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "9.8.1",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "drizzle-orm": "^0.45.4",
    "feed": "^6.0.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "use-intl": "^4.14.9",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "latest",
    "drizzle-kit": "^0.31.11",
    "leva": "^0.10.1",
    "satori": "0.33.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "^1.2.1",
    "wrangler": "4.151.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^24.22.3",
    "pnpm": ">=11.20.0 <12"
  },
  "type": "module"
}
