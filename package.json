    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "drizzle-orm": "^0.45.4",
    "feed": "^6.0.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "three": "^0.185.1",
    "unified": "^11.0.5",
    "use-intl": "^4.14.9",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
