{
  "name": "fhfs",
  "version": "0.1.0",
  "private": true,
  "description": "fhf's — a personal magazine and private gallery: writing, software, motion studies, and a few rooms with their own records.",
  "homepage": "https://fhfs.fhfs.workers.dev",
  "repository": "github:fanhefeng/fhfs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "pnpm assets && vp dev --host 127.0.0.1",
    "build": "pnpm assets && vp build",
    "preview": "vp preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "deploy": "pnpm assets && void deploy --platform cloudflare",
    "deploy:cloudflare": "pnpm assets && void deploy --platform cloudflare",
    "assets": "node scripts/prepare-assets.mjs && tsx scripts/prepare-share-images.ts",
    "prepare": "void prepare",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
