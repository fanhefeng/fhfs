{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node", "void/env"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "ops",
    "scripts/db-snapshot-guard.mts",
    "scripts/export-public-snapshot.mts",
    "scripts/media.mts",
    "scripts/monitor.mts",
    "scripts/private-backup.mts",
    "scripts/e2e.mts",
    "scripts/uptime.mts",
    "tests/e2e",
    "playwright.config.ts",
    "vite.config.ts",
    "void.config.ts",
    "env.ts",
    ".void/env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "src/lib/__tests__"]
}
