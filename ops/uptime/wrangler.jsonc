{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fhfs-uptime",
  "account_id": "fb12b12d229e15430dd17b9af5d6f1fe",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["no_brotli_content_encoding", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true },
  },
}
